# Copy this file to `.env` and fill in real values. Do NOT commit `.env`.

# --- Anthropic Claude ---------------------------------------------------------
# https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# --- Firecrawl ----------------------------------------------------------------
# https://firecrawl.dev
FIRECRAWL_API_KEY=fc-...

# --- Google Sheets ------------------------------------------------------------
# Path to the downloaded service-account JSON (kept out of version control).
GOOGLE_CREDENTIALS_PATH=credentials.json
# Sheet ID taken from the sheet URL: .../spreadsheets/d/<SHEET_ID>/edit
GOOGLE_SHEET_ID=

# --- IndexNow -----------------------------------------------------------------
# Any random alphanumeric string; host <key>.txt on the client domain to verify.
INDEXNOW_KEY=

# --- App ----------------------------------------------------------------------
AGENCY_NAME=Wabi Sabi Agency
APP_HOST=0.0.0.0
APP_PORT=8000
